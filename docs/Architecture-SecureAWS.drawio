D6;fontSize=11;" edge="1" parent="1" source="peer_visuance" target="vpc_visuance"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;strokeColor=#545B64;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="users" target="rp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="VPN UDP 1194" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;strokeColor=#545B64;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="users" target="ovpn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Sortie dépôts (filtrée)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;strokeColor=#545B64;fontColor=#232F3E;fontSize=11;" edge="1" parent="1" source="sq" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="MATRICE DE FLUX (deny par défaut)&amp;#10;1. Internet -&gt; OpenVPN : UDP 1194 (seul accès admin)&amp;#10;2. Internet -&gt; Reverse Proxy : TCP 443 (seul accès applicatif)&amp;#10;3. Tunnel VPN 10.5.0.0/24 -&gt; Bastion : SSH 22 (admin via VPN only)&amp;#10;4. Bastion/Ansible -&gt; Web/Proxy/RP/VPN : SSH 22&amp;#10;5. Reverse Proxy -&gt; Web clients : 80 (via peering)&amp;#10;6. Web clients -&gt; Squid : 3128 -&gt; dépôts packages seulement&amp;#10;7. Web client -&gt; RDS (intra-VPC) · -&gt; S3 (VPC Endpoint)&amp;#10;8. Client cybersky/drox360/visuance : ÉTANCHES entre eux (pas de peering croisé)&amp;#10;&amp;#10;ROUTAGE : VPC clients SANS Internet Gateway. Sortie uniquement via Squid, entrée via Reverse Proxy." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FBFBEF;strokeColor=#D4B106;fontSize=12;fontColor=#232F3E;spacing=10;" vertex="1" parent="1"><mxGeometry x="110" y="910" width="800" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>